<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>slam_bringup</name>
  <version>0.1.0</version>
  <description>Launch files and configs for LIO-VIO-GPS multi-source SLAM fusion pipeline</description>
  <maintainer email="haohua@todo.com">haohua</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>fast_lio</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
